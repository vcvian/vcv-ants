:: test.j.painting.1.brute.retry
{=

(metadata:
"title", "Pattern 1: Brute-Force (Retry?)",
)

($funcMainContent:
[{Failed challenge.
<br>
Retry (boosted by fixation) or quit (reduced by fixation)?
<br>
Quitting is not very attractive at this point.}],
[{
<ol>

<li>($funcCheckGate: "Spend a fixation to retry.", true, "fixation", 1, false, 100, [], "test.j.painting.1.brute.step1", "")</li>
<li>($funcLuckGate: "Quit.", 50, [], "test.j.painting.1.resolve.quit", "test.j.painting.1.resolve.stall")</li>
</ol>

<br>
(display: "test.cheatConsole")

}],
true)


