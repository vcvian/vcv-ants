:: test.j.painting.2.pickApproach
{=

(metadata: "title", "Pattern 2: Pick Approach")

($funcMainContent:
[{
For this test, only 1 approach is available.
}],
[{
<ol>

<li>($funcOutLink: "Brute-force approach.", "No check.", "test.j.painting.2.brute.step1", [])</li>

</ol>

<br>
(display: "test.cheatConsole")}],
true
)


:: test.j.painting.2.brute.step1
{=

(metadata: "title", "Pattern 2: Brute-Force (Step 1)")

($funcMainContent:
[{
The player cannot back down until they fail.
<br>
Chance should be variable.
}],
[{
<ol>

<li>
(set: _baseChance to 70)
|=
($funcLuckGate: "Try.", ($funcChance: _baseChance, (passage: "table.chanceMod")'s paintBrute), [], "test.j.painting.2.brute.step2", "test.j.painting.2.brute.retry")
=|
($funcChanceReadout: _baseChance, (passage: "table.chanceMod")'s paintBrute)
</li>

</ol>

<br>
(display: "test.cheatConsole")}],
true
)


