)


:: test.j.painting.2.roadblock
{=

(metadata:
"title", "Pattern 2: Roadblock",
)

($funcMainContent:
[{At a crossroad...}],
[{
<ol>

<li>($funcDummyLink: "This is a dummy link.", "It will be replaced with a proper challenge later. Reaching this point is sufficient in this test.")</li>

Or...
<li>($funcOutLink: "Worry about that later. Good place as any to stop...", "Know when to quit.", "test.j.painting.2.resolve.consolation", [])</li>

</ol>

<br>
(display: "test.cheatConsole")

}],
true)


