[(goto: "Jesse C2a")]<!--[[Jesse C2a]]--><span class="desc">(print: $actionCommit's desc)</span></li>
<li>(link: "Return to your routine. You have so much left to do.")[(print: $actionBack's effect)] <span class="desc">(print: $actionBack's desc)</span>
