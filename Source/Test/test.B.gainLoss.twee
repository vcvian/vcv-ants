''Testing `$funcGainLoss`''
<br>
$cssDesc[Sample use: `($funcGainLoss: "restless", 1)` will gain the player 1 Restless flag.]

<ol>
<li>(link-rerun: "Gain 1 Restlessness")[($funcGainLoss: "restless", 1)(rerun: ?pocket)]</li>
<li>(link-rerun: "Lose 1 Restlessness")[($funcGainLoss: "restless", -1)(rerun: ?pocket)]</li>
</ol>

