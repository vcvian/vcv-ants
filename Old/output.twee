$mind > 7 and $attEmbarrassed's qt > 0 or
$mind > 7 and $attRestlessness's qt > 0 or
$mind > 7 and $attJesse01's qt  > 0 or
$mind > 7 and $attProgress's qt  > 0
)[(set: $lockDreamEStage2 to true)(goto: "Dream E")]]

