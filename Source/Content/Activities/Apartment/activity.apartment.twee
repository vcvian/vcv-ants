:: activity.apartment [activity]
{=

(metadata:

"relayCode", [{
        <!--must always name them _relayLink and _relayDestination and _relayTip.-->
        (set: _relayLink to (cond:
            ($funcOpenStorylets:) contains "story.aManWasHere", "A man was here...",
            ($funcOpenStorylets:) contains "story.apartmentStudioDirty", "Observe your place of living.",
            "Look at your apartment"
        ))

        (set: _relayDestination to (cond:
            ($funcOpenStorylets:) contains "story.aManWasHere", "story.aManWasHere",
            ($funcOpenStorylets:) contains "story.apartmentStudioDirty", "story.apartmentStudioDirty",
            false
        ))

        (set: _relayTip to (cond:
            ($funcOpenStorylets:) contains "story.aManWasHere", "You can sense him.",
            ($funcOpenStorylets:) contains "story.apartmentStudioDirty", "Look around.",
            false
        ))
}],

)