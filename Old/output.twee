<!--(variable text 1-3 based on $HenriE1)-->

<!--end of scenario 1-->
(if: $HenriE1 is 1)[
//“Talk about me? What’s there to talk about? I’d much rather (link-reveal: "hear about you.")[(show: ?hidden1)]”//

[
