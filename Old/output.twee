(if: $lockAntsC2 is true and $lockAntsC4 is false)[(goto: "Ants C4")]<!--[[Ants C4]]-->

<!--Suppression raid, transfers to stage 3-->
(if: $lockJesseAmyA is true or $lockJesseHenriA is true or $lockJesseWindowA is true or $eventShow's timer <-6)[(if: $eventShow's timer <0 and $lockPoliceB is true and $lockPoliceC is true and $lockPoliceD is false)[(goto: "Police D")]]<!--[[Police D]]-->

<!--Redirect before conditions are met-->
(if: $eventParty's timer >= -1 or $eventEmail's progress < 5)
[(goto: "Dream 1")]

<!--[[Dream E]] conditions, get punished for hoarding-->
