:: activity.laptop [activity]
{=

(metadata:

"relayCode", [{
        <!--must always name them _relayLink and _relayDestination and _relayTip.-->
        (set: _relayLink to (cond:
            ($funcOpenStorylets:) contains "story.newsOfWorld", "What news of the world?",
            ($funcOpenStorylets:) contains "story.laptop1", "Approach your laptop.",
            false
        ))

        (set: _relayDestination to (cond:
            ($funcOpenStorylets:) contains "story.newsOfWorld", "story.newsOfWorld",
            ($funcOpenStorylets:) contains "story.laptop1", "story.laptop1",
            false
        ))

        (set: _relayTip to (cond:
            ($funcOpenStorylets:) contains "story.newsOfWorld", "Perhaps you are not entirely isolated.",
            ($funcOpenStorylets:) contains "story.laptop1", "Your portal to the outside world.",
            false
        ))
}],

)

Laptop