]
(else-if: $storyAnts's qt is 3 and $lockAntsC2 is true)[<li>(link: "Inspect the ant bait around the apartment.")[(goto: "Ants C3")] <span class="desc">(print: $actionObs's desc)</span></li><!--[[Ants C3]]-->
]
(else-if: $storyAnts's qt is 4)[<li>(link: "Look at your ant-free apartment.")[(goto: "Ants D")] <span class="desc">(print: $actionObs's desc)</span></li><!--[[Ants D]]-->
]


