:: test.j.painting.1.brute.step2
{=

(metadata:
"title", "Pattern 1: Brute-Force (Step 2)",
)

($funcMainContent:
[{Succeeded once. Now do it again!
<br>
Fixation increases chance.
<br>
Quitting becomes available; it is the most attractive early on. Its chance should be reduced by having fixation. Reading content should signal the presence of fixation.}],
[{
<ol>

<li>($funcLuckGate: "Try.", 80, [], "test.j.painting.1.brute.step3", "test.j.painting.1.brute.retry")</li>
<li>($funcLuckGate: "Quit.", 100, [], "test.j.painting.1.resolve.quit", "test.j.painting.1.resolve.stall")</li>

</ol>

<br>
(display: "test.cheatConsole")

}],
true)


