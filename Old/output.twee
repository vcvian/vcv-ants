(set: $place to "in the hallway")(replace: ?place)[$place]
(set: $activity to "talking to the pantsuited woman")(replace: ?activity)[$activity]

//“Tell me,”// the pantsuited woman says to you in the hallway. //“Why are you looking for Katherine?”//
