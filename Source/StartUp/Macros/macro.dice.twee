:: macro.dice [startup]
{=

<!--basic dice roll, output a _success boolean & notification. Front-facing.-->
(set: $funcDiceRoll to (macro: num-type _chance, [(out:)[{
   <!--initialize-->
    (set: _success to false)

    <!--roll-->
    (set: _dice to (random: 1,100))
    (if: _dice >= (100-_chance) or _chance >= 100)[(set: _success to true)]

    <!--notify result-->
    (if: _chance < 100)[(dialog: [{
        (if: _success)[(color: green+yellow)[Success!]<br>Fortune has decided to smile on you.]
        (else:)[(color: red+orange)[Failure...]<br>Fortune, ever the fickle mistress, turns her back on you.]
        <br>
        $cssDesc[Threshold: (print: 100-_chance), rolled ''_dice''.]
    }], "OK.")]

}]]))


<!--a table dice roll, which takes in a "loot table" and outputs a string. Meant to be used as aid in controlled randomization code, so not front-facing-->
(set: $funcTableRoll to (macro: dm-type _table, [{
    <!--initialize-->
    (set: _out to "")

    <!--calculate sum-->
    (set: _sum to 0)
    (for: each _item, ...(datanames: _table))[{
        (set: _sum to it + (_table's _item))
    }]

    <!--roll dice-->
    (set: _tableDice to (random: 1, _sum))

    <!--determine where dice falls on (_out)-->
    (set: _weightStack to 0)<!--weight stacks progressively gets bigger with each loop-->

    (for: each _item, ...(datanames: _table))[{
        <!--the if here is to ensure that rolling stops if something is picked, otherwise it'll just select the last item-->
        (if: _out is "")[{
            <!--increase _weightStack-->
            (set: _weightStack to it + (_table's _item))
            <!--does dice fall on item?-->
            (if: _tableDice <= _weightStack)[(set: _out to _item)]
        }]<!--end of if not picked an _out yet-->
    }]<!--end of looping-->

    <!--output-->
    (out-data: _out)
}]))


<!--color code chance number-->
(set: $cssChanceColor to (macro: str-type _formattedText, num-type _value, num-type _max, [(out:)[{
    <!--color gradient for chance-->
(set: _r to 0)
(set: _g to 0)
(set: _half to (round: _max/2))
(if: _value <= _half)[
	(set: _r to 255)
	(set: _g to (round: (_value / _half) * 255))
		(if: _g > 255)[(set: _g to 255)]
		(elseif: _g < 0)[(set: _g to 0)]
]
(else:)[
	(set: _r to (round: ((_max - _value) / _half) * 255))
		(if: _r > 255)[(set: _r to 255)]
		(elseif: _r < 0)[(set: _r to 0)]
	(set: _g to 255)
]
(set: _chanceColor to (color: (rgb: _r, _g, 0)))

<!--output formatted text-->
_chanceColor[_formattedText]
}]]))