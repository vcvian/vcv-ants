:: test.j.painting.2.brute.retry
{=

(metadata: "title", "Pattern 2: Brute-Force (Retry)")

($funcMainContent:
[{
Dang it... Retry? (Spend fixation)
<br>
Having fixation should make it more difficult to quit.
}],
[{
<ol>
<li>($funcCheckGate: "Spend a fixation to retry.", true, "fixation", 1, true, 100, [], "test.j.painting.2.brute.step1", "")</li>
<li>
(set: _baseChance to 80)
|=
($funcLuckGate: "Nah, make peace with this...", ($funcChance: _baseChance, (passage: "table.chanceMod")'s paintQuit), [], "test.j.painting.2.resolve.quit", "test.j.painting.2.resolve.stall")
=|
($funcChanceReadout: _baseChance, (passage: "table.chanceMod")'s paintQuit)
</li>
</ol>

<br>
(display: "test.cheatConsole")}],
true
)


:: test.j.painting.2.resolve.quit
{=

